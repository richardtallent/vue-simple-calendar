{
	"name": "vue-simple-calendar",
	"version": "7.3.0",
	"private": false,
	"type": "module",
	"description": "Simple Vue 3 calendar event control",
	"author": "richardtallent <richard@tallent.us>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/richardtallent/vue-simple-calendar.git"
	},
	"homepage": "https://tallent.us/vue-simple-calendar/",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"main": "./dist/vue-simple-calendar.umd.cjs",
	"module": "./dist/vue-simple-calendar.js",
	"types": "./dist/lib/main.d.ts",
	"style": "./dist/style.css",
	"files": [
		"dist",
		"static"
	],
	"exports": {
		".": {
			"types": "./dist/lib/main.d.ts",
			"import": "./dist/vue-simple-calendar.js",
			"require": "./dist/vue-simple-calendar.umd.cjs"
		},
		"./interfaces": {
			"types": "./dist/lib/interfaces.d.ts"
		},
		"./dist/vue-simple-calendar.css": {
			"import": "./dist/vue-simple-calendar.css",
			"require": "./dist/vue-simple-calendar.css"
		},
		"./dist/css/default.css": {
			"import": "./dist/css/default.css",
			"require": "./dist/css/default.css"
		},
		"./dist/css/gcal.css": {
			"import": "./dist/css/gcal.css",
			"require": "./dist/css/gcal.css"
		},
		"./dist/css/holidays-us.css": {
			"import": "./dist/css/holidays-us.css",
			"require": "./dist/css/holidays-us.css"
		},
		"./dist/css/holidays-ue.css": {
			"import": "./dist/css/holidays-ue.css",
			"require": "./dist/css/holidays-ue.css"
		}
	},
	"scripts": {
		"dev": "vite",
		"devs": "vite --https",
		"build": "vite build",
		"test": "TZ=America/New_York vitest run && TZ=Pacific/Auckland vitest run && TZ=UTC vitest run"
	},
	"dependencies": {
		"vue": "^3.5.44"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8.71.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/compiler-sfc": "^3.5.44",
		"@vue/language-core": "^3.3.13",
		"eslint": "^10.13.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-vue": "^10.11.1",
		"prettier": "^3.9.10",
		"rollup-plugin-typescript2": "^0.37.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vite-plugin-dts": "^5.1.2",
		"vitest": "^5.0.5"
	},
	"eslintConfig": {
		"extends": [
			"plugin:vue/vue3-recommended",
			"eslint:recommended",
			"@vue/prettier"
		],
		"parserOptions": {
			"parser": "@typescript-eslint/parser"
		}
	},
	"prettier": {
		"useTabs": true,
		"semi": false,
		"singleQuote": false,
		"bracketSpacing": true,
		"trailingComma": "es5",
		"printWidth": 160
	},
	"browserslist": [
		"defaults",
		"not IE 11",
		"maintained node versions"
	]
}
